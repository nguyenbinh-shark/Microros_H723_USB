[Unit]
Description=Micro-ROS Agent for STM32 Robot
After=network.target

[Service]
Type=simple
User=root
ExecStart=/bin/bash -c "source /opt/ros/jazzy/setup.bash && ros2 run micro_ros_agent micro_ros_agent serial --dev /dev/stm32_robot -b 115200"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
